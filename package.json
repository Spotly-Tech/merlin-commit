{
    "name": "merlin-commit",
    "version": "1.0.1",
    "description": "🧙‍♂️ Magical, interactive CLI for creating conventional commits",
    "type": "module",
    "main": "./dist/cli.js",
    "types": "./dist/cli.d.ts",
    "bin": {
        "merlin": "./bin/merlin.js",
        "merlin-commit": "./bin/merlin.js"
    },
    "exports": {
        ".": {
            "import": "./dist/cli.js",
            "types": "./dist/cli.d.ts"
        }
    },
    "files": [
        "dist",
        "bin",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "clean": "rimraf dist",
        "lint": "eslint src/ tests/",
        "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"docs/**/*.md\"",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "prepublishOnly": "npm run build",
        "prepare": "husky || true",
        "knip": "knip"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mBukator/merlin-commit.git"
    },
    "keywords": [
        "git",
        "commit",
        "conventional-commits",
        "cli",
        "interactive",
        "commitlint",
        "husky",
        "typescript"
    ],
    "author": "mBukator",
    "license": "MIT",
    "engines": {
        "node": ">=18"
    },
    "dependencies": {
        "@inquirer/prompts": "^8.5.0",
        "chalk": "^5.6.2",
        "commander": "^15.0.0",
        "execa": "^9.6.1",
        "ora": "^9.4.0"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.0.2",
        "@commitlint/config-conventional": "^21.0.2",
        "@eslint/js": "^10.0.1",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@types/node": "^26.1.0",
        "@typescript-eslint/eslint-plugin": "^8.60.0",
        "@typescript-eslint/parser": "^8.53.0",
        "@vitest/coverage-v8": "^4.1.7",
        "eslint": "^10.4.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import-x": "^4.16.2",
        "globals": "^17.6.0",
        "knip": "^6.17.1",
        "lint-staged": "^17.0.5",
        "prettier": "^3.8.3",
        "rimraf": "^6.1.3",
        "typescript": "^6.0.3",
        "vitest": "^4.0.17"
    },
    "peerDependencies": {
        "@commitlint/config-conventional": ">=19.0.0",
        "husky": ">=9.0.0"
    },
    "peerDependenciesMeta": {
        "@commitlint/config-conventional": {
            "optional": true
        },
        "husky": {
            "optional": true
        }
    },
    "bugs": {
        "url": "https://github.com/mBukator/merlin-commit/issues"
    },
    "homepage": "https://github.com/mBukator/merlin-commit#readme",
    "lint-staged": {
        "src/**/*.ts": [
            "eslint --fix",
            "prettier --write"
        ],
        "tests/**/*.ts": [
            "eslint --fix",
            "prettier --write"
        ]
    }
}
